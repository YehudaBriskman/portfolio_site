log_format main_ext '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'rt=$request_time urt=$upstream_response_time '
                    'uaddr=$upstream_addr ustatus=$upstream_status '
                    'host=$host req_id=$request_id';

access_log /dev/stdout main_ext;
error_log  /dev/stderr info;

# No brotli, and not by oversight: `nginx -V` on nginx:alpine reports
# --with-http_gzip_static_module but no brotli, and the only dynamic modules the
# image ships are acme, geoip, image_filter, js and xslt. Precompressing .br
# alongside the .gz would just add bytes to the image that nothing can serve,
# and the alternative is compiling an nginx module, which costs far more than
# the ~15% brotli would save on an already-gzipped bundle. Revisit if the base
# image ever grows one.
gzip              on;
gzip_static       on;      # serve .gz built at image-build time, no per-request CPU
gzip_vary         on;
gzip_comp_level   6;
gzip_min_length   1024;
gzip_proxied      any;
gzip_types        application/javascript text/javascript text/css application/json
                  image/svg+xml application/manifest+json application/rss+xml;

# The platform's own DNS, whatever the platform is.
#
# This was hardcoded to 10.43.0.10 — kube-dns — which is right in the cluster
# and unreachable anywhere else. Under Docker Compose every proxy_pass that
# goes through a variable timed out against it for thirty seconds and then
# fell back to the SPA shell, so the SEO routes silently served the wrong
# body and the API hung. It looked like the API was down.
#
# `NGINX_LOCAL_RESOLVERS` is filled by the base image's own
# /docker-entrypoint.d/15-local-resolvers.envsh from /etc/resolv.conf, so it
# is Docker's embedded resolver under Compose and kube-dns in the cluster
# with nothing to configure in either. That is also why this file is a
# template: substitution is limited to NGINX_* so nginx's own $variables
# survive it untouched.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

server_tokens off;

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Applied to every response, including errors and redirects.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # The site embeds nothing and should be embedded by nobody.
  add_header Content-Security-Policy "frame-ancestors 'none'" always;

  # public/projects/ is a real directory of screenshots, and it collides with
  # the /projects route. try_files' "$uri/" matched the directory and answered
  # with a 301 to "http://host:8080/projects/" — nginx builds those from its
  # own listen port, so the redirect pointed at a port nothing serves and the
  # page was simply broken on a hard load. Redirects now stay relative, and the
  # directory probe is gone: this app has no directory listings to serve.
  absolute_redirect off;
  port_in_redirect off;

  # One name for the API, resolved per request. Declared here because the
  # first location that uses it is the next one; every SEO route below reads
  # the same variable.
  set $api_upstream "api:5000";

  location ^~ /api/ {
    # Through the variable, not the literal name.
    #
    # nginx resolves a hostname written directly into proxy_pass exactly once,
    # when it starts. Redeploy the API and it gets a new address; nginx keeps
    # dialling the old one and every /api/ request answers 502 until the web
    # container is restarted too. A variable forces resolution per request,
    # which is why every other proxy_pass in this file already uses one —
    # this location was the only one that did not, so the SEO routes survived
    # an API redeploy and the entire data layer did not.
    # No URI part on purpose. With a literal host, `proxy_pass http://api:5000/api/`
    # replaces the matched `/api/` prefix with `/api/` — a no-op that reads as
    # deliberate. With a variable, nginx stops doing that substitution and
    # sends only the URI written here, so the same line delivered every
    # request to `/api/` and the API answered a JSON 404. Dropping the path
    # passes the original request URI through untouched, which is what the
    # literal form was achieving all along.
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;

    proxy_set_header X-Request-Id       $request_id;
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto  $scheme;

    proxy_read_timeout   60s;
    proxy_connect_timeout 5s;
    proxy_send_timeout   60s;

    # The upstream address is a pod IP. Useful in a log, not on a public
    # response; the request id is enough to correlate one.
    add_header X-Request-Id $request_id always;
  }

  # ---------------------------------------------------------------- SEO ----
  # A slug never contains a dot (the schema forbids it), so excluding dots keeps
  # these from swallowing real files: /projects/windom-card.jpg was being sent to
  # the renderer as if "windom-card.jpg" were a project, and 404ing.
  #
  # Crawlers do not run JavaScript. Served straight from the SPA shell, every
  # URL on this domain would report the home page's title and image, so the
  # content routes are rendered by the API with a per-URL head instead.
  #
  # 5xx falls back to the plain shell: a crawler seeing generic tags is a much
  # smaller failure than a visitor seeing an error page. 404 is deliberately
  # NOT intercepted — the API returns a real 404 with a shell body, which is
  # exactly what a missing post should answer.
  # The home page too: without this a crawler reads an empty #root and reports
  # the site as having no heading and almost no words.
  location = / {
    proxy_pass http://$api_upstream/api/seo/render/home;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location = /sitemap.xml {
    proxy_pass http://$api_upstream/api/seo/sitemap.xml;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @empty_sitemap;
  }

  location = /feed.xml {
    proxy_pass http://$api_upstream/api/seo/feed.xml;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  # robots.txt is proxied for the same reason the sitemap is: the copy in
  # web/public/ is baked at image-build time and hardcodes
  # `Sitemap: https://yehudabriskman.com/sitemap.xml`, so every host built from
  # this image served a robots.txt claiming to be production — preprod points
  # crawlers at production's sitemap today. The API builds the body from
  # SITE_URL, which is per-environment, so each host names itself.
  location = /robots.txt {
    proxy_pass http://$api_upstream/api/seo/robots.txt;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @static_robots;
  }

  location = /blog {
    proxy_pass http://$api_upstream/api/seo/render/blog;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location = /projects {
    proxy_pass http://$api_upstream/api/seo/render/projects;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location ~ "^/blog/([^/.]+)/?$" {
    proxy_pass http://$api_upstream/api/seo/render/blog/$1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location ~ "^/projects/([^/.]+)/?$" {
    proxy_pass http://$api_upstream/api/seo/render/projects/$1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location @spa {
    #
    # The shell must never be cached, and `location = /index.html` was not
    # enough to say so.
    #
    # Every real route — `/`, `/blog`, `/projects`, `/blog/<slug>` — is
    # served through this named location, and a named location is not the
    # URI `/index.html`, so that rule never matched any of them. They went
    # out with an ETag and a Last-Modified and no Cache-Control at all,
    # which leaves the browser to invent its own freshness lifetime. A
    # returning visitor could then be handed a stale shell pointing at
    # hashed asset filenames the next deploy had already deleted — a blank
    # page, from a cache, with nothing in the logs.
    #
    add_header Cache-Control "no-cache" always;
    try_files /index.html =404;
  }

  # An empty urlset beats a 502: Search Console retries a valid empty sitemap,
  # but records an error against the site for a broken one.
  location @empty_sitemap {
    default_type application/xml;
    return 200 '<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"></urlset>';
  }

  # The static file, which is what every host served until the location above
  # existed. Falling back to it rather than to a `return 200` keeps one copy of
  # the rules in the repository instead of a second, divergent copy inlined
  # here, and the only line it can get wrong is the Sitemap one — which is
  # correct on production, the one host where a crawler can read it at all.
  #
  # Serving something matters more than serving the right thing here: Google
  # treats a 5xx on robots.txt as "crawl nothing from this host" and keeps
  # treating it that way for up to a day on a cached failure, so a brief API
  # outage would otherwise cost far more than slightly stale rules.
  #
  # A missing file is deliberately a plain 404 and not the server's
  # `error_page 404 /index.html`: a 404 on robots.txt means "no restrictions"
  # to every crawler, whereas the SPA shell would be a 200 of HTML parsed as
  # robots directives, and a crawler reading `<!doctype html>` as a rule file
  # does unpredictable things with the rest of it.
  # No add_header here, deliberately: nginx's add_header replaces the
  # server-level set rather than adding to it, so a Cache-Control line here
  # would quietly strip HSTS and nosniff off this response — and the block at
  # the top of this server says those apply to every response. The file is
  # served with an ETag and a Last-Modified, so a crawler revalidates anyway,
  # and Google caches robots.txt for about a day whatever the headers say.
  location @static_robots {
    error_page 404 = @plain_404;
    try_files /robots.txt =404;
  }

  # nginx's default mime table has no entry for .webmanifest, so it was served
  # as application/octet-stream and some browsers ignore it.
  location = /site.webmanifest {
    default_type application/manifest+json;
    add_header Cache-Control "public, max-age=86400" always;
  }

  # A missing asset gets a plain 404, not the app shell: the HTML body is
  # useless to a <script> tag and only confuses whoever is reading the network
  # panel.
  location @plain_404 {
    default_type text/plain;
    return 404 "not found\n";
  }

  # Content-hashed build output really is immutable.
  location ~* ^/assets/.*\.(js|css|woff2?)$ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  location ~* ^/fonts/.*\.woff2?$ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  # Stable filenames. An updated OG card must not be pinned for a month in every
  # browser and every social scraper.
  #
  # avif, mp4 and webm were missing here, and nothing below matched them either,
  # so they fell through to "location /" and went out with no Cache-Control at
  # all. With no freshness information a browser revalidates on every
  # navigation, which meant the heaviest files on the site — the day plates in
  # /plates/, and any video — were the only assets not being cached. They are
  # the same kind of thing as the rest of this list and expire the same way.
  location ~* \.(png|jpe?g|gif|webp|avif|svg|ico|mp4|webm)$ {
    add_header Cache-Control "public, max-age=86400" always;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache" always;
  }

  #
  # A trailing slash on a real section is a typo, not a different page.
  location = /blog/ { return 308 /blog; }
  location = /projects/ { return 308 /projects; }

  #
  # Unknown paths render the app but answer 404.
  #
  # Every unrouted URL used to return 200 with the home page's shell, canonical
  # and index directive — an unbounded supply of indexable duplicates. The real
  # routes are matched above; anything left here is not a page.
  #
  # error_page without an "=" keeps the original status, so the app still boots
  # and shows its own not-found screen while the response says 404. Using
  # "try_files /index.html" here instead would serve the same body with a 200,
  # which is the soft-404 this is meant to remove.
  #
  location / {
    try_files $uri =404;
  }

  error_page 404 /index.html;

}
