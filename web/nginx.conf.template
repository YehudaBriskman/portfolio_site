log_format main_ext '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent '
                    '"$http_referer" "$http_user_agent" '
                    'rt=$request_time urt=$upstream_response_time '
                    'uaddr=$upstream_addr ustatus=$upstream_status '
                    'host=$host req_id=$request_id';

access_log /dev/stdout main_ext;

# The same line with the path and never the query string: the remote MCP
# server's OAuth endpoints (#263) carry authorization codes and states in
# theirs, and a credential has no business in a log. `$uri` is the
# normalised path alone.
log_format mcp_ext '$remote_addr - $remote_user [$time_local] '
                   '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                   '"-" "$http_user_agent" '
                   'rt=$request_time urt=$upstream_response_time '
                   'uaddr=$upstream_addr ustatus=$upstream_status '
                   'host=$host req_id=$request_id';
error_log  /dev/stderr info;

# No brotli, and not by oversight: `nginx -V` on nginx:alpine reports
# --with-http_gzip_static_module but no brotli, and the only dynamic modules the
# image ships are acme, geoip, image_filter, js and xslt. Precompressing .br
# alongside the .gz would just add bytes to the image that nothing can serve,
# and the alternative is compiling an nginx module, which costs far more than
# the ~15% brotli would save on an already-gzipped bundle. Revisit if the base
# image ever grows one.
gzip              on;
gzip_static       on;      # serve .gz built at image-build time, no per-request CPU
gzip_vary         on;
gzip_comp_level   6;
gzip_min_length   1024;
gzip_proxied      any;
gzip_types        application/javascript text/javascript text/css application/json
                  image/svg+xml application/manifest+json application/rss+xml;

# The platform's own DNS, whatever the platform is.
#
# This was hardcoded to 10.43.0.10 — kube-dns — which is right in the cluster
# and unreachable anywhere else. Under Docker Compose every proxy_pass that
# goes through a variable timed out against it for thirty seconds and then
# fell back to the SPA shell, so the SEO routes silently served the wrong
# body and the API hung. It looked like the API was down.
#
# `NGINX_LOCAL_RESOLVERS` is filled by the base image's own
# /docker-entrypoint.d/15-local-resolvers.envsh from /etc/resolv.conf, so it
# is Docker's embedded resolver under Compose and kube-dns in the cluster
# with nothing to configure in either. That is also why this file is a
# template: substitution is limited to NGINX_* so nginx's own $variables
# survive it untouched.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

server_tokens off;

# The three identity headers the admin gate speaks in (backend/src/middlewares/
# requireAdmin.ts): who oauth2-proxy says this is, and the proof that the
# request crossed the gated router. nginx passes every client header upstream
# unless told otherwise, so on the public domain whatever a visitor wrote in
# them reached the API as written (oci-free #22).
#
# Whether to forward them is a property of the host in front of this image,
# not of the image, so it is a variable, and every proxied location reads it
# through proxy-headers.conf:
#
#   on   pass them through. The default, because preprod needs it: its one
#        Ingress sends /api/ to THIS nginx after strip-identity, github-auth
#        and inject-proxy-secret have run, so the headers arriving here are
#        the gate's own, and dropping them answers every admin call 401.
#        Compose has no gate and nothing to lose either way.
#   off  drop them. Production's public web Deployment sets this. Its admin
#        host never reaches nginx for /api (that Ingress path goes straight to
#        the api Service), so nothing legitimate arrives here carrying them.
#
# A proxy_set_header whose value comes out empty is not sent at all, which is
# what `default ""` relies on; `on` hands the client's value on unchanged, and
# an absent header stays absent.
map "${NGINX_FORWARD_IDENTITY}" $fwd_auth_request_user {
  on      $http_x_auth_request_user;
  default "";
}
map "${NGINX_FORWARD_IDENTITY}" $fwd_auth_request_email {
  on      $http_x_auth_request_email;
  default "";
}
map "${NGINX_FORWARD_IDENTITY}" $fwd_admin_proxy_secret {
  on      $http_x_admin_proxy_secret;
  default "";
}

server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Applied to every response, including errors and redirects — but only to
  # responses from blocks that declare no add_header of their own, because
  # nginx's add_header replaces the inherited set instead of extending it.
  # Hence the file: every location below that sets a header of its own
  # includes it too, and CI's preflight fails the build if one forgets.
  include /etc/nginx/snippets/security-headers.conf;

  # public/projects/ is a real directory of screenshots, and it collides with
  # the /projects route. try_files' "$uri/" matched the directory and answered
  # with a 301 to "http://host:8080/projects/" — nginx builds those from its
  # own listen port, so the redirect pointed at a port nothing serves and the
  # page was simply broken on a hard load. Redirects now stay relative, and the
  # directory probe is gone: this app has no directory listings to serve.
  absolute_redirect off;
  port_in_redirect off;

  # One name for the API, resolved per request. Declared here because the
  # first location that uses it is the next one; all sixteen proxy_pass lines in
  # this file — /api/, the three crawler files, the nine rendered pages and the
  # three remote-MCP locations —
  # read this one variable, so the host is stated once.
  #
  # The host is templated, and that is the whole repair for the preprod 502s.
  #
  # `resolver` above takes *nameservers* from /etc/resolv.conf and nothing
  # else: nginx has no equivalent of libc's `search` list and never appends a
  # domain. So it asked kube-dns for the bare name `api` as an absolute name,
  # which has no record, and every /api/ request answered 502 with
  #
  #     api could not be resolved (3: Host not found)
  #
  # in the error log. A shell in the same pod resolves `api` perfectly well,
  # which is exactly what made this read as "the API is down" rather than as a
  # resolver problem — libc appends the search domains and nginx does not. The
  # pod's list is
  #
  #     search preprod.svc.cluster.local svc.cluster.local cluster.local ...
  #
  # so inside the cluster the only name that resolves with no search list is
  # the fully-qualified `api.<namespace>.svc.cluster.local`.
  #
  # That name cannot simply be written here: this one template also serves
  # Docker Compose, where the host is the Compose service name `api` on a
  # user-defined network and no domain is appended to anything. So the host
  # arrives as a variable — defaulted to `api` by ENV in the Dockerfile, which
  # is what Compose and a plain `docker run` get, and overridden per namespace
  # by the web Deployment in the oci-free repository.
  #
  # NGINX_API_HOST and not API_HOST: NGINX_ENVSUBST_FILTER is pinned to NGINX_
  # in the Dockerfile so that nginx's own $uri, $request_id and $api_upstream
  # survive envsubst, and a name outside that prefix would be copied into the
  # output untouched. Note what happens if it is ever unset at build time: it
  # also survives literally, and nginx then refuses to start on an unknown
  # variable rather than booting with an empty host. That is the loud failure,
  # and it is the right one for the value every API call depends on.
  set $api_upstream "${NGINX_API_HOST}:5000";

  location ^~ /api/ {
    # Through the variable, not the literal name.
    #
    # nginx resolves a hostname written directly into proxy_pass exactly once,
    # when it starts. Redeploy the API and it gets a new address; nginx keeps
    # dialling the old one and every /api/ request answers 502 until the web
    # container is restarted too. A variable forces resolution per request,
    # which is why every other proxy_pass in this file already uses one —
    # this location was the only one that did not, so the SEO routes survived
    # an API redeploy and the entire data layer did not.
    # No URI part on purpose. With a literal host, `proxy_pass http://api:5000/api/`
    # replaces the matched `/api/` prefix with `/api/` — a no-op that reads as
    # deliberate. With a variable, nginx stops doing that substitution and
    # sends only the URI written here, so the same line delivered every
    # request to `/api/` and the API answered a JSON 404. Dropping the path
    # passes the original request URI through untouched, which is what the
    # literal form was achieving all along.
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;

    include /etc/nginx/snippets/proxy-headers.conf;

    proxy_read_timeout   60s;
    proxy_connect_timeout 5s;
    proxy_send_timeout   60s;

    # The media library's largest upload is a video with its poster and
    # captions (#253): 25 + 5 MB + 200 KB, ~30.3 MB as a form. nginx's own
    # default is 1 MB, which refused it here with a 413 before the API saw
    # it. The admin host's /api goes straight to the API Service and never
    # passes this file, so this is the Compose stack and the public domain
    # (a token with ADMIN_API_TOKENS=on). Every other route keeps its own,
    # smaller ceiling in the API (express.json is 1 MB), and each media kind
    # its own (images 10 MB, icons 64 KB).
    client_max_body_size 31m;

    # The upstream address is a pod IP. Useful in a log, not on a public
    # response; the request id is enough to correlate one.
    add_header X-Request-Id $request_id always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # ---------------------------------------------------------------- SEO ----
  # A slug never contains a dot (the schema forbids it), so excluding dots keeps
  # these from swallowing real files: /projects/windom-card.jpg was being sent to
  # the renderer as if "windom-card.jpg" were a project, and 404ing.
  #
  # Crawlers do not run JavaScript. Served straight from the SPA shell, every
  # URL on this domain would report the home page's title and image, so the
  # content routes are rendered by the API with a per-URL head instead.
  #
  # 5xx falls back to the plain shell: a crawler seeing generic tags is a much
  # smaller failure than a visitor seeing an error page. 404 is deliberately
  # NOT intercepted — the API returns a real 404 with a shell body, which is
  # exactly what a missing post should answer.
  #
  # That fallback is for pages. The three crawler files each have one of their
  # own — an empty urlset, the static robots.txt, and a 503 for the feed —
  # because a program parsing XML or rules has no use for an HTML shell.
  #
  # Every proxied location includes proxy-headers.conf, for the same
  # inheritance reason the security headers are a snippet; see that file.
  # The home page too: without this a crawler reads an empty #root and reports
  # the site as having no heading and almost no words.
  location = / {
    proxy_pass http://$api_upstream/api/seo/render/home;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location = /sitemap.xml {
    proxy_pass http://$api_upstream/api/seo/sitemap.xml;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @empty_sitemap;
  }

  location = /feed.xml {
    proxy_pass http://$api_upstream/api/seo/feed.xml;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @feed_unavailable;
  }

  # robots.txt is proxied for the same reason the sitemap is: the copy in
  # web/public/ is baked at image-build time and hardcodes
  # `Sitemap: https://yehudabriskman.com/sitemap.xml`, so every host built from
  # this image served a robots.txt claiming to be production — preprod points
  # crawlers at production's sitemap today. The API builds the body from
  # SITE_URL, which is per-environment, so each host names itself.
  location = /robots.txt {
    proxy_pass http://$api_upstream/api/seo/robots.txt;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @static_robots;
  }

  # The IndexNow key file (#308). The protocol scopes a key to the directory
  # its file is in, so it has to be at the root; the API answers only for the
  # key in INDEXNOW_KEY and 404s every other name.
  location ~ "^/([a-f0-9]{32})\.txt$" {
    proxy_pass http://$api_upstream/api/seo/indexnow/$1.txt;
    include /etc/nginx/snippets/proxy-headers.conf;
  }

  location = /blog {
    proxy_pass http://$api_upstream/api/seo/render/blog;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location = /projects {
    proxy_pass http://$api_upstream/api/seo/render/projects;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  # The Journey page and the accessibility statement (#240). Neither had a
  # location, so both fell through to `location /` and answered 404 with the
  # home page's head on a direct load, while the app booted over it and looked
  # fine. The statement is the page IS 5568 requires a site to publish, so a
  # 404 there is worse than a wrong preview. web/src/test/nginx-config.test.ts
  # now fails for any public route in App.tsx that has no rendered location.
  location = /story {
    proxy_pass http://$api_upstream/api/seo/render/story;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location = /accessibility {
    proxy_pass http://$api_upstream/api/seo/render/accessibility;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  # ------------------------------------------------------ remote MCP (#263) --
  # The MCP endpoint, its public twin, the OAuth endpoints that sign a client
  # in, and the discovery metadata, all answered by the API. The API itself
  # answers 404 on every one of them while MCP_REMOTE=off, so nothing here
  # changes with the switch.
  #
  # Logged without query strings (mcp_ext above): /mcp/oauth/authorize and the
  # GitHub callback carry codes and states in theirs. No buffering, so a
  # streamed MCP response is not held back. The API sets its own CSP on the
  # consent pages; the site's one from the server block still applies on top,
  # and a browser enforces both.
  location = /mcp {
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_buffering off;
    proxy_read_timeout 120s;
    access_log /dev/stdout mcp_ext;
  }

  location ^~ /mcp/ {
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_buffering off;
    proxy_read_timeout 120s;
    access_log /dev/stdout mcp_ext;
  }

  # RFC 9728 and RFC 8414 metadata: /.well-known/oauth-protected-resource[/mcp]
  # and /.well-known/oauth-authorization-server. Nothing else under
  # /.well-known/ goes to the API.
  location ^~ /.well-known/oauth- {
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    include /etc/nginx/snippets/proxy-headers.conf;
    access_log /dev/stdout mcp_ext;
  }

  # The page that explains it all, rendered like the other static pages.
  location = /developers/mcp {
    proxy_pass http://$api_upstream/api/seo/render/developers/mcp;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  # An area's page (#225). Two segments, so the one-segment location below
  # never matched it, and a direct load or a shared link fell through to
  # `location /` and answered 404 with the home page's head while the app
  # booted over it and looked fine (#238). The renderer answers 404 itself for
  # an unknown or hidden area, so nothing here needs to know which exist.
  location ~ "^/blog/area/([^/.]+)/?$" {
    proxy_pass http://$api_upstream/api/seo/render/blog/area/$1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location ~ "^/blog/([^/.]+)/?$" {
    proxy_pass http://$api_upstream/api/seo/render/blog/$1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location ~ "^/projects/([^/.]+)/?$" {
    proxy_pass http://$api_upstream/api/seo/render/projects/$1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  # The Hebrew site (#248): every page again under /he, in Hebrew and right
  # to left. One location for all of them, because the renderer already knows
  # every page's path: /he/blog/x goes to /api/seo/render/he/blog/x, /he to
  # /api/seo/render/he/, and an address that is no page answers the
  # renderer's 404. A dot anywhere is a file, as for the English pages, so
  # nothing under /he/ is ever mistaken for an asset or vice versa.
  location ~ "^/he(?:/([^.]*))?$" {
    proxy_pass http://$api_upstream/api/seo/render/he/$1;
    include /etc/nginx/snippets/proxy-headers.conf;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
  }

  location @spa {
    #
    # The shell must never be cached, and `location = /index.html` was not
    # enough to say so.
    #
    # Every real route — `/`, `/blog`, `/projects`, `/blog/<slug>` — is
    # served through this named location, and a named location is not the
    # URI `/index.html`, so that rule never matched any of them. They went
    # out with an ETag and a Last-Modified and no Cache-Control at all,
    # which leaves the browser to invent its own freshness lifetime. A
    # returning visitor could then be handed a stale shell pointing at
    # hashed asset filenames the next deploy had already deleted — a blank
    # page, from a cache, with nothing in the logs.
    #
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files /index.html =404;
  }

  # An empty urlset beats a 502: Search Console retries a valid empty sitemap,
  # but records an error against the site for a broken one.
  location @empty_sitemap {
    default_type application/xml;
    return 200 '<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"></urlset>';
  }

  # The feed fails honestly: a 503 that says when to come back, never the shell.
  #
  # It used to fall back to @spa like the rendered pages, and that is the right
  # fallback for a page and the wrong one for anything a program parses.
  # Measured on production with the API down (#125): 200, text/html, 5,360
  # bytes of app shell at /feed.xml. A feed reader takes the 200 at its word,
  # tries to parse <!doctype html> as RSS, and either marks the subscription
  # broken or — worse — decides the feed now has no items.
  #
  # Why a 503 and not an empty feed, when the sitemap above gets an empty
  # urlset: the two readers treat "empty" differently. Search Console retries
  # a valid empty sitemap and loses nothing, because it already holds the
  # URLs. A feed reader that is told the channel has no items has been told
  # something false, and some of them act on it. A 503 with Retry-After is
  # the one answer every reader understands as "temporary, ask again", and it
  # is what the API itself would have said had nginx let it through.
  #
  # Plain text, so that nothing which sniffs a body can mistake it for a feed
  # or a page, and no-store, so that no cache between here and the reader
  # keeps the outage after the API is back.
  #
  # The empty `types` block is what makes it plain text. default_type only
  # applies when the extension is not in the mime table, and the URI here is
  # still /feed.xml — without it nginx labelled this sentence `text/xml`, which
  # is measured, not assumed (the @empty_sitemap above goes out as text/xml for
  # the same reason, and there it is harmless because its body is XML).
  location @feed_unavailable {
    types { }
    default_type text/plain;
    add_header Retry-After 300 always;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/security-headers.conf;
    return 503 "feed temporarily unavailable\n";
  }

  # The static file, which is what every host served until the location above
  # existed. Falling back to it rather than to a `return 200` keeps one copy of
  # the rules in the repository instead of a second, divergent copy inlined
  # here, and the only line it can get wrong is the Sitemap one — which is
  # correct on production, the one host where a crawler can read it at all.
  #
  # Serving something matters more than serving the right thing here: Google
  # treats a 5xx on robots.txt as "crawl nothing from this host" and keeps
  # treating it that way for up to a day on a cached failure, so a brief API
  # outage would otherwise cost far more than slightly stale rules.
  #
  # A missing file is deliberately a plain 404 and not the server's
  # `error_page 404 /index.html`: a 404 on robots.txt means "no restrictions"
  # to every crawler, whereas the SPA shell would be a 200 of HTML parsed as
  # robots directives, and a crawler reading `<!doctype html>` as a rule file
  # does unpredictable things with the rest of it.
  # Still no Cache-Control here, but that is now a caching decision rather
  # than a security one: the file goes out with an ETag and a Last-Modified so
  # a crawler revalidates anyway, and Google caches robots.txt for about a day
  # whatever the headers say. Adding one would cost nothing now: it would come
  # with security-headers.conf alongside it, the way every other block's does.
  location @static_robots {
    error_page 404 = @plain_404;
    try_files /robots.txt =404;
  }

  # nginx's default mime table has no entry for .webmanifest, so it was served
  # as application/octet-stream and some browsers ignore it.
  location = /site.webmanifest {
    default_type application/manifest+json;
    add_header Cache-Control "public, max-age=86400" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # A missing asset gets a plain 404, not the app shell: the HTML body is
  # useless to a <script> tag and only confuses whoever is reading the network
  # panel.
  location @plain_404 {
    default_type text/plain;
    return 404 "not found\n";
  }

  # Content-hashed build output really is immutable.
  location ~* ^/assets/.*\.(js|css|woff2?)$ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  location ~* ^/fonts/.*\.woff2?$ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  # Stable filenames. An updated OG card must not be pinned for a month in every
  # browser and every social scraper.
  #
  # avif, mp4 and webm were missing here, and nothing below matched them either,
  # so they fell through to "location /" and went out with no Cache-Control at
  # all. With no freshness information a browser revalidates on every
  # navigation, which meant the heaviest files on the site — the day plates in
  # /plates/, and any video — were the only assets not being cached. They are
  # the same kind of thing as the rest of this list and expire the same way.
  location ~* \.(png|jpe?g|gif|webp|avif|svg|ico|mp4|webm)$ {
    add_header Cache-Control "public, max-age=86400" always;
    include /etc/nginx/snippets/security-headers.conf;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  # The theme before first paint (#247). A stable name with no content hash,
  # loaded by every shell, so it revalidates like the shell does: a cached
  # copy that disagreed with the stylesheet about the storage key or the
  # attribute would paint every page in the wrong theme until it expired.
  location = /theme-boot.js {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
    error_page 404 = @plain_404;
    try_files $uri =404;
  }

  # Also where every HTML 404 lands: `error_page 404 /index.html` at the foot
  # of this server is an internal redirect to this URI, so the not-found
  # document is served from here and not from @spa.
  location = /index.html {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  #
  # A trailing slash on a real section is a typo, not a different page.
  location = /blog/ { return 308 /blog; }
  location = /projects/ { return 308 /projects; }
  location = /story/ { return 308 /story; }
  location = /accessibility/ { return 308 /accessibility; }
  location = /developers/mcp/ { return 308 /developers/mcp; }

  #
  # Removed projects (2026-11-03). Their pages are gone but links to them are
  # out in the world, so they land on the index rather than on a 404. Exact
  # locations win over the `^/projects/...` regex above.
  location = /projects/change11 { return 308 /projects; }
  location = /projects/change11/ { return 308 /projects; }
  location = /projects/text-encrypting { return 308 /projects; }
  location = /projects/text-encrypting/ { return 308 /projects; }

  #
  # Unknown paths render the app but answer 404.
  #
  # Every unrouted URL used to return 200 with the home page's shell, canonical
  # and index directive — an unbounded supply of indexable duplicates. The real
  # routes are matched above; anything left here is not a page.
  #
  # error_page without an "=" keeps the original status, so the app still boots
  # and shows its own not-found screen while the response says 404. Using
  # "try_files /index.html" here instead would serve the same body with a 200,
  # which is the soft-404 this is meant to remove.
  #
  location / {
    try_files $uri =404;
  }

  error_page 404 /index.html;

}
