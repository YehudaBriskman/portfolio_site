# Every variable the API reads, as declared in src/env.ts. The schema is parsed
# at startup, so a missing required value fails the process rather than the
# first request that needs it.
#
# Copy to .env and fill in. Never commit the filled-in copy.

NODE_ENV=development
PORT=5000

# ── Mail ────────────────────────────────────────────────────────────────────
# smtp requires SMTP_HOST, SMTP_USER and SMTP_PASS; emailjs requires the three
# EMAILJS_ values instead. The schema enforces whichever set you pick.
EMAIL_PROVIDER=smtp

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=
# EMAILJS_SERVICE_ID=

# Required in every configuration.
MAIL_FROM=noreply@yehudabriskman.com
MAIL_REPLY_TO=
CONTACT_TO=you@example.com

# ── Content store ───────────────────────────────────────────────────────────
# Defaults point at the in-cluster service. The API starts even when CouchDB is
# unreachable, so none of these are required to boot.
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=portfolio_api
COUCHDB_PASSWORD=

# ── Admin gate ──────────────────────────────────────────────────────────────
# Empty fails closed: a misconfigured deploy locks the admin surface rather
# than opening it. Set this to the shared secret the reverse proxy injects.
ADMIN_PROXY_SECRET=
ADMIN_GITHUB_LOGIN=YehudaBriskman
# Bearer API tokens for automation (mcp/README.md): off | tunnel | on.
# off (default) ignores them; tunnel accepts them only over kubectl
# port-forward; on accepts them from anywhere, the public domain included.
ADMIN_API_TOKENS=off

# ── Public identity ─────────────────────────────────────────────────────────
# Every absolute URL crawlers see is built from SITE_URL, so it must be the
# public name of the site. WEB_ORIGIN is where the built SPA shell is fetched
# from for per-URL head injection.
SITE_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Search engines (#308). All public by design, and all optional.
# INDEXNOW_KEY: 32 hex characters (`openssl rand -hex 16`); a publish pings
# IndexNow and /<key>.txt serves the key. Only sent from a host robots.txt opens.
# The verification tokens are the `content` of the meta tag each console hands out.
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
