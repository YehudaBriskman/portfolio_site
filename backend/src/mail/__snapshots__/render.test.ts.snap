<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="card" bgcolor="#FBFAF6" style="width:100%;max-width:600px;table-layout:fixed;background-color:#FBFAF6;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,'Noto Sans Hebrew','Arial Hebrew',sans-serif">
<tr><td class="card" bgcolor="#FBFAF6" height="24" style="height:24px;line-height:24px;font-size:1px;background-color:#FBFAF6;border-radius:10px 10px 0 0">&nbsp;</td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:0px 24px 16px 24px"><p class="soft" dir="auto" style="margin:0;font-size:13px;line-height:1.4;font-weight:700;color:#55524A;letter-spacing:.06em;text-transform:uppercase">New post</p></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:0px 24px 16px 24px"><img src="https://example.test/c.png" alt="Card" width="552" height="290" style="display:block;width:100%;max-width:552px;height:auto;border:0;border-radius:6px"></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:0px 24px 16px 24px"><h1 class="ink" dir="auto" style="margin:0;font-size:24px;line-height:1.3;font-weight:700;color:#14130F">A title</h1></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:0px 24px 16px 24px"><p class="ink" dir="auto" style="margin:0;font-size:16px;line-height:1.5;color:#14130F">First line<br>Second line</p></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:0px 24px 16px 24px"><ul class="ink" style="margin:0;padding:0;padding-inline-start:22px;font-size:16px;line-height:1.5;color:#14130F"><li dir="auto" style="margin:0 0 4px 0">one</li><li dir="auto" style="margin:0 0 4px 0">two</li></ul></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:4px 24px 20px 24px"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="btn" bgcolor="#14130F" height="44" style="background-color:#14130F;border-radius:8px"><a class="btna" href="https://example.test/blog/a" style="display:inline-block;min-height:20px;padding:12px 24px;font-size:16px;line-height:20px;font-weight:700;color:#FFFFFF;text-decoration:none">Read it</a></td></tr></table></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:0px 24px 16px 24px"><div class="rule" style="border-top:1px solid #CFC9B8;font-size:1px;line-height:1px;height:1px">&nbsp;</div></td></tr>
<tr><td class="card" bgcolor="#FBFAF6" style="background-color:#FBFAF6;overflow-wrap:break-word;word-break:break-word;padding:12px 24px 24px 24px"><div class="rule" style="border-top:1px solid #CFC9B8;padding-top:14px"><p class="soft" style="margin:0 0 8px 0;font-size:13px;line-height:1.5;color:#55524A"><bdi>Dana</bdi><br><bdi>dana@example.org</bdi></p><p class="soft" dir="auto" style="margin:0;font-size:13px;line-height:1.5;color:#55524A">Unsubscribe: <a href="https://example.test/u?t=1" class="lnk" style="color:#1D4ED8;text-decoration:underline">https://example.test/u?t=1</a></p></div></td></tr>
</table></td></tr></table></body></html>"
`;

