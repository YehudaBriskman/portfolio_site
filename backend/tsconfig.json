{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    // TS 7 removed node10 ("Node"). node16/nodenext would demand explicit
    // extensions on dynamic imports in tests; "bundler" keeps node10's
    // extensionless lookup while honouring package exports. Emit is unchanged:
    // still CommonJS, and Node's own require() does the runtime resolution.
    "moduleResolution": "bundler",
    // @emailjs/nodejs ships an exports map with no "types" condition, so any
    // resolver that honours exports (everything but the node10 that TS 7
    // removed) finds its JS and no declarations. Point at the ones it ships.
    "paths": { "@emailjs/nodejs": ["./node_modules/@emailjs/nodejs/mjs/index.d.ts"] },
    // ES2022 for Array.prototype.at, which the MCP tools shared with mcp/
    // use (src/mcp/shared, #259). Node 20+ has had it for years.
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    // The Hebrew glossary (src/i18n/glossary.json, a copy of the web app's, #307).
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}